#
# Configuración para Raspberry Pi (1, 2 y Zero 2W)
# Kernel: 5.10.103-v7+
#

# Ruta del kernel source/build (ajustar según tu sistema)
export KERNELPATH="/lib/modules/5.10.103-v7+/build"

# Arquitectura del kernel
export KERNELARCH="arm"

# Toolchain para Raspberry Pi (armhf)
export TOOLPREFIX="arm-linux-gnueabihf-"

# Ruta del toolchain (si usas una toolchain personalizada)
export TOOLCHAIN="/usr/bin"

# Agregar toolchain al PATH
export PATH=${TOOLCHAIN}:${PATH}

# Build configuration
export DEF_CFG80211_INTERNAL_REGDB=y

# Usar libnl local o no
export BUILD_LIBNL=y
export INCLUDE_LIBNL11_HEADER=${ATH_TOPDIR}/apps/libnl-1/include
export INCLUDE_LIBNL11_LIB="-lm ${ATH_TOPDIR}/apps/libnl-1/lib/libnl.a"

# Compatibilidad con kernel 5.10+
export COMPILKIND="release armhf hardfloat glibc"

# Dispositivos USB soportados para Raspberry Pi
# 0cf3:9374 - Atheros AR9271 (Raspberry Pi Zero 2W)
# 0cf3:9375 - Atheros AR9271 (Raspberry Pi 1/2)
export SUPPORTED_USB_IDS="0cf3:9374 0cf3:9375"

# Parámetros del driver para Raspberry Pi
export DEFAULT_MODULE_PARAMS="ath6kl_p2p=0x19 debug_quirks=0x200"
